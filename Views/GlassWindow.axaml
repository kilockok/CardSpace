<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PersonalCardDemo.Converters"
        xmlns:config="clr-namespace:PersonalCardDemo.Config"
        x:Class="PersonalCardDemo.Views.GlassWindow"
        x:DataType="vm:CardViewModel"
        xmlns:vm="clr-namespace:PersonalCardDemo.ViewModels"
        Width="960" Height="680"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Transparent"
        SystemDecorations="None">

  <Window.Resources>
    <conv:IconKeyConverter x:Key="IconKeyConverter"/>
    <conv:ColorStringConverter x:Key="ColorStringConverter"/>
  </Window.Resources>

  <Window.Styles>

    <Style Selector="Button.traffic">
      <Setter Property="Width" Value="13"/>
      <Setter Property="Height" Value="13"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.traffic TextBlock.icon">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,-1,0,0"/>
    </Style>
    <Style Selector="Button.traffic-close">
      <Setter Property="Background" Value="#FF5F57"/>
    </Style>
    <Style Selector="Button.traffic-minimize">
      <Setter Property="Background" Value="#FEBC2E"/>
    </Style>
    <Style Selector="Button.traffic-maximize">
      <Setter Property="Background" Value="#28C840"/>
    </Style>
    <Style Selector="StackPanel.traffic-group:pointerover Button.traffic TextBlock.icon">
      <Setter Property="Foreground" Value="#4D000000"/>
    </Style>
    <Style Selector="Button.traffic-close:pointerover">
      <Setter Property="Background" Value="#FF4136"/>
    </Style>
    <Style Selector="Button.traffic-minimize:pointerover">
      <Setter Property="Background" Value="#F5C451"/>
    </Style>
    <Style Selector="Button.traffic-maximize:pointerover">
      <Setter Property="Background" Value="#2ACB42"/>
    </Style>
    <Style Selector="Button.traffic:pressed">
      <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <Style Selector="Border.tag">
      <Setter Property="Background" Value="{DynamicResource GlassTagBackground}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform" Value="scale(1,1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.tag:pointerover">
      <Setter Property="Background" Value="#28FFFFFF"/>
      <Setter Property="RenderTransform" Value="scale(1.06,1.06)"/>
    </Style>
    <Style Selector="Border.tag TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource GlassTagForeground}"/>
    </Style>

    <Style Selector="Button.social">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="CornerRadius" Value="21"/>
      <Setter Property="Background" Value="{DynamicResource GlassSocialBackground}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform" Value="scale(1,1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
          <BrushTransition Property="Background" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.social:pointerover">
      <Setter Property="Background" Value="{DynamicResource GlassSocialHoverBackground}"/>
      <Setter Property="RenderTransform" Value="scale(1.12,1.12)"/>
    </Style>
    <Style Selector="Button.social:pressed">
      <Setter Property="Background" Value="#35FFFFFF"/>
      <Setter Property="RenderTransform" Value="scale(0.94,0.94)"/>
    </Style>

    <Style Selector="Border.tech-item">
      <Setter Property="Background" Value="{DynamicResource GlassTechItemBackground}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="BorderBrush" Value="#08FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform" Value="scale(1,1) translateY(0)"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.tech-item:pointerover">
      <Setter Property="Background" Value="#1AFFFFFF"/>
      <Setter Property="BorderBrush" Value="#20FFFFFF"/>
      <Setter Property="RenderTransform" Value="scale(1.04,1.04) translateY(-1px)"/>
    </Style>

    <!-- 卡片入场过渡 -->
    <Style Selector="Border.glass-card">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>

  </Window.Styles>

  <Border CornerRadius="16" ClipToBounds="True">

    <Grid RowDefinitions="40,*">

      <!-- 半透明背景层 -->
      <Border Grid.RowSpan="2" IsHitTestVisible="False"
              Background="{DynamicResource GlassBackgroundGradient}"/>

      <!-- 光晕 -->
      <Ellipse Grid.RowSpan="2" Width="500" Height="260" Opacity="0.15"
               IsHitTestVisible="False" VerticalAlignment="Top" Margin="0,-80,0,0">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#FFE8A849" Offset="0"/>
            <GradientStop Color="#00E8A849" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- 标题栏 -->
      <Border Grid.Row="0" Background="Transparent">
        <Grid>
          <StackPanel Classes="traffic-group" Orientation="Horizontal" Spacing="8"
                      Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Button Classes="traffic traffic-close" Click="CloseButton_Click">
              <TextBlock Classes="icon" Text="&#xd7;"/>
            </Button>
            <Button Classes="traffic traffic-minimize" Click="MinimizeButton_Click">
              <TextBlock Classes="icon" Text="&#x2013;"/>
            </Button>
            <Button Classes="traffic traffic-maximize" Click="MaximizeButton_Click">
              <TextBlock Classes="icon" Text="+"/>
            </Button>
          </StackPanel>
          <TextBlock Text="个人主页" FontSize="13" FontWeight="Medium"
                     Foreground="{DynamicResource GlassTitleForeground}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- 主内容 -->
      <Grid Grid.Row="1" Margin="24"
            ColumnDefinitions="300,*" RowDefinitions="*,200"
            ColumnSpacing="24" RowSpacing="24">

        <!-- 左侧资料卡 -->
        <Border x:Name="ProfileCard" Grid.RowSpan="2" Classes="glass-card" CornerRadius="10" ClipToBounds="True" Opacity="0">
          <Panel>
            <ExperimentalAcrylicBorder IsHitTestVisible="False">
              <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                    TintColor="#FFFFFF" TintOpacity="0.02" MaterialOpacity="0.15"/>
              </ExperimentalAcrylicBorder.Material>
            </ExperimentalAcrylicBorder>

            <Border BorderBrush="{DynamicResource GlassCardBorder}" BorderThickness="1"
                    Background="{DynamicResource GlassCardGradient}">
              <Border.Effect>
                <DropShadowEffect OffsetX="0" OffsetY="8" BlurRadius="16" Color="#000000" Opacity="0.10"/>
              </Border.Effect>

              <Grid RowDefinitions="160,Auto,*">
                <Panel Grid.Row="0">
                  <Border Background="{DynamicResource GlassCoverGradient}"/>
                  <Image Source="avares://PersonalCardDemo/Assets/cover.jpg" Stretch="UniformToFill"/>
                </Panel>

                <Border Grid.Row="1" Width="90" Height="90" CornerRadius="45"
                        HorizontalAlignment="Center" Margin="0,-45,0,0"
                        BorderThickness="1.5" BorderBrush="{DynamicResource GlassAvatarBorder}"
                        ClipToBounds="True">
                  <Panel>
                    <Border CornerRadius="42" Background="{DynamicResource GlassAvatarGradient}">
                      <TextBlock Text="{Binding AvatarFallback}" FontSize="34" FontWeight="SemiBold"
                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="42" ClipToBounds="True">
                      <Image Source="avares://PersonalCardDemo/Assets/avatar.png" Stretch="UniformToFill"/>
                    </Border>
                  </Panel>
                </Border>

                <StackPanel Grid.Row="2" Spacing="16" Margin="24,8,24,24">
                  <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource GlassTextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Id}" FontSize="13"
                               Foreground="{DynamicResource GlassTextTertiary}" HorizontalAlignment="Center"/>
                  </StackPanel>

                  <ItemsControl ItemsSource="{Binding Tags}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" ItemSpacing="8"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Border Classes="tag">
                          <TextBlock Text="{Binding}"/>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border Height="1" Background="#15FFFFFF" Margin="8,2"/>

                  <TextBlock Text="{Binding Signature}" FontStyle="Italic" FontSize="13"
                             Foreground="{DynamicResource GlassTextSecondary}" TextAlignment="Center"/>

                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                              Spacing="16" Margin="0,4,0,0">
                    <Button Classes="social" Click="XButton_Click">
                      <PathIcon Data="{StaticResource XIcon}" Foreground="White" Width="18" Height="18"/>
                    </Button>
                    <Button Classes="social" Click="GitHubButton_Click">
                      <PathIcon Data="{StaticResource GitHubIcon}" Foreground="White" Width="18" Height="18"/>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </Panel>
        </Border>

        <!-- 右上: 地图卡 -->
        <Border x:Name="MapCard" Grid.Column="1" Grid.Row="0" Classes="glass-card" CornerRadius="10" ClipToBounds="True" Opacity="0">
          <Panel>
            <ExperimentalAcrylicBorder IsHitTestVisible="False">
              <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                    TintColor="#FFFFFF" TintOpacity="0.02" MaterialOpacity="0.15"/>
              </ExperimentalAcrylicBorder.Material>
            </ExperimentalAcrylicBorder>

            <Border BorderBrush="{DynamicResource GlassCardBorder}" BorderThickness="1"
                    Background="{DynamicResource GlassCardGradient}">
              <Border.Effect>
                <DropShadowEffect OffsetX="0" OffsetY="8" BlurRadius="16" Color="#000000" Opacity="0.10"/>
              </Border.Effect>

              <Grid>
                <Border Background="{DynamicResource GlassMapGradient}"/>
                <Image Source="avares://PersonalCardDemo/Assets/map.png" Stretch="UniformToFill"/>
                <Border VerticalAlignment="Bottom" Padding="24,16"
                        Background="{DynamicResource GlassMapOverlayGradient}">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{StaticResource LocationIcon}"
                                Foreground="{DynamicResource GlassLocationForeground}" Width="18" Height="18"/>
                      <TextBlock Text="{Binding City}" FontSize="16" FontWeight="SemiBold"
                                 Foreground="{DynamicResource GlassTextPrimary}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding LocationDescription}" FontSize="13"
                               Foreground="{DynamicResource GlassTextSecondary}" Margin="26,0,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </Panel>
        </Border>

        <!-- 右下 -->
        <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">

          <!-- 技术栈卡 -->
          <Border x:Name="TechCard" Grid.Column="0" Classes="glass-card" CornerRadius="10" ClipToBounds="True" Opacity="0">
            <Panel>
              <ExperimentalAcrylicBorder IsHitTestVisible="False">
                <ExperimentalAcrylicBorder.Material>
                  <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                      TintColor="#FFFFFF" TintOpacity="0.02" MaterialOpacity="0.15"/>
                </ExperimentalAcrylicBorder.Material>
              </ExperimentalAcrylicBorder>

              <Border BorderBrush="{DynamicResource GlassCardBorder}" BorderThickness="1"
                      Background="{DynamicResource GlassCardGradient}">
                <Border.Effect>
                  <DropShadowEffect OffsetX="0" OffsetY="8" BlurRadius="16" Color="#000000" Opacity="0.10"/>
                </Border.Effect>

                <StackPanel Margin="16,14" Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource CodeIcon}"
                              Foreground="{DynamicResource GlassAccentBrush}" Width="14" Height="14"/>
                    <TextBlock Text="Tech Stack" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource GlassTextPrimary}"/>
                  </StackPanel>

                  <ItemsControl ItemsSource="{Binding TechStack}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="10"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="config:TechStackItem">
                        <Border Classes="tech-item">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{Binding Icon, Converter={StaticResource IconKeyConverter}}"
                                      Foreground="{Binding Color, Converter={StaticResource ColorStringConverter}}"
                                      Width="12" Height="12"/>
                            <TextBlock Text="{Binding Name}" FontSize="11"
                                       Foreground="{DynamicResource GlassTechText}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border Height="1" Background="#15FFFFFF" Margin="0,2,0,0"/>

                  <ItemsControl ItemsSource="{Binding Links}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="config:LinkItem">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                          <PathIcon Data="{Binding Icon, Converter={StaticResource IconKeyConverter}}"
                                    Foreground="{DynamicResource GlassLinkForeground}" Width="12" Height="12"/>
                          <TextBlock Text="{Binding Text}" FontSize="11"
                                     Foreground="{DynamicResource GlassLinkForeground}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Panel>
          </Border>

          <!-- 理念卡 -->
          <Border x:Name="PhilosophyCard" Grid.Column="1" Classes="glass-card" CornerRadius="10" ClipToBounds="True" Opacity="0">
            <Panel>
              <ExperimentalAcrylicBorder IsHitTestVisible="False">
                <ExperimentalAcrylicBorder.Material>
                  <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                      TintColor="#FFFFFF" TintOpacity="0.02" MaterialOpacity="0.15"/>
                </ExperimentalAcrylicBorder.Material>
              </ExperimentalAcrylicBorder>

              <Border BorderBrush="{DynamicResource GlassCardBorder}" BorderThickness="1"
                      Background="{DynamicResource GlassCardGradient}">
                <Border.Effect>
                  <DropShadowEffect OffsetX="0" OffsetY="8" BlurRadius="16" Color="#000000" Opacity="0.10"/>
                </Border.Effect>

                <StackPanel Margin="20,18" Spacing="10" VerticalAlignment="Center">
                  <Border Width="32" Height="4" CornerRadius="2"
                          Background="{DynamicResource GlassAccentBrush}" HorizontalAlignment="Left"/>
                  <TextBlock Text="{Binding PhilosophyTitle}" FontSize="15" FontWeight="SemiBold"
                             Foreground="{DynamicResource GlassTextPrimary}" Margin="0,2,0,0"/>
                  <Border BorderThickness="3,0,0,0" BorderBrush="#40FFFFFF" Padding="12,4,0,4">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding PhilosophyQuote}" FontSize="12.5"
                                 Foreground="{DynamicResource GlassTextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                      <TextBlock Text="{Binding PhilosophyAttribution}" FontSize="12"
                                 Foreground="{DynamicResource GlassTextTertiary}" FontStyle="Italic"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </Panel>
          </Border>

        </Grid>
      </Grid>
    </Grid>
  </Border>

</Window>
