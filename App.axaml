<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PersonalCardDemo.App">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- ============ Light ============ -->
                <ResourceDictionary x:Key="Light">
                    <!-- 窗口 -->
                    <SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="WindowBorder" Color="#D1D1D1"/>

                    <!-- 标题栏 -->
                    <SolidColorBrush x:Key="TitleBarBackground" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="TitleBarBorder" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="TitleBarForeground" Color="#404040"/>
                    <SolidColorBrush x:Key="CaptionHover" Color="#0A000000"/>
                    <SolidColorBrush x:Key="CaptionPressed" Color="#12000000"/>
                    <SolidColorBrush x:Key="CaptionForeground" Color="#1A1A1A"/>

                    <!-- 卡片 -->
                    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBorder" Color="#E5E5E5"/>

                    <!-- 文字 -->
                    <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#606060"/>
                    <SolidColorBrush x:Key="TextTertiary" Color="#8A8A8A"/>
                    <SolidColorBrush x:Key="TextOnAccent" Color="White"/>

                    <!-- 标签 -->
                    <SolidColorBrush x:Key="TagBackground" Color="#E8F0FE"/>
                    <SolidColorBrush x:Key="TagForeground" Color="#0067C0"/>
                    <SolidColorBrush x:Key="TagHoverBackground" Color="#D6E4FA"/>

                    <!-- 社交按钮 -->
                    <SolidColorBrush x:Key="SocialBackground" Color="#F0F0F0"/>
                    <SolidColorBrush x:Key="SocialBorder" Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="SocialHoverBackground" Color="#E8F0FE"/>
                    <SolidColorBrush x:Key="SocialHoverBorder" Color="#B4D6FA"/>
                    <SolidColorBrush x:Key="SocialPressedBackground" Color="#D4E4F7"/>
                    <SolidColorBrush x:Key="SocialPressedBorder" Color="#84BBF0"/>
                    <SolidColorBrush x:Key="SocialIconForeground" Color="#404040"/>

                    <!-- 技术栈 -->
                    <SolidColorBrush x:Key="TechItemBackground" Color="#F5F5F5"/>
                    <SolidColorBrush x:Key="TechItemBorder" Color="#E8E8E8"/>
                    <SolidColorBrush x:Key="TechItemHoverBackground" Color="#EBF0F7"/>
                    <SolidColorBrush x:Key="TechItemHoverBorder" Color="#B4D6FA"/>
                    <SolidColorBrush x:Key="TechItemText" Color="#404040"/>

                    <!-- 分隔线 -->
                    <SolidColorBrush x:Key="Separator" Color="#E8E8E8"/>
                    <SolidColorBrush x:Key="SeparatorLight" Color="#EBEBEB"/>

                    <!-- 地图叠加层 -->
                    <SolidColorBrush x:Key="MapOverlayBackground" Color="#FAFAFA"/>
                    <SolidColorBrush x:Key="MapOverlayBorder" Color="#E0E0E0"/>

                    <!-- 引用边框 -->
                    <SolidColorBrush x:Key="QuoteBorder" Color="#D0D8E8"/>

                    <!-- 头像边框 -->
                    <SolidColorBrush x:Key="AvatarBorder" Color="#FFFFFF"/>

                    <!-- 封面渐变 -->
                    <LinearGradientBrush x:Key="CoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0067C0" Offset="0"/>
                        <GradientStop Color="#0078D4" Offset="0.3"/>
                        <GradientStop Color="#50A0E6" Offset="0.7"/>
                        <GradientStop Color="#78B9E7" Offset="1"/>
                    </LinearGradientBrush>

                    <!-- 地图渐变 -->
                    <LinearGradientBrush x:Key="MapGradientBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D4E4F7" Offset="0"/>
                        <GradientStop Color="#B8D4F0" Offset="0.5"/>
                        <GradientStop Color="#A3C8E8" Offset="1"/>
                    </LinearGradientBrush>

                    <!-- Logo 渐变 -->
                    <LinearGradientBrush x:Key="LogoGradientBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0078D4" Offset="0"/>
                        <GradientStop Color="#50A0E6" Offset="1"/>
                    </LinearGradientBrush>

                    <!-- 主题切换按钮 -->
                    <SolidColorBrush x:Key="ThemeToggleForeground" Color="#606060"/>

                    <!-- 强调色 -->
                    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>

                    <!-- 位置图标 -->
                    <SolidColorBrush x:Key="LocationIconForeground" Color="#D13438"/>

                    <!-- 头像 fallback 背景 -->
                    <SolidColorBrush x:Key="AvatarFallbackBackground" Color="#0078D4"/>
                </ResourceDictionary>

                <!-- ============ Dark ============ -->
                <ResourceDictionary x:Key="Dark">
                    <!-- 窗口 -->
                    <SolidColorBrush x:Key="WindowBackground" Color="#1C1C1C"/>
                    <SolidColorBrush x:Key="WindowBorder" Color="#3A3A3A"/>

                    <!-- 标题栏 -->
                    <SolidColorBrush x:Key="TitleBarBackground" Color="#1C1C1C"/>
                    <SolidColorBrush x:Key="TitleBarBorder" Color="#333333"/>
                    <SolidColorBrush x:Key="TitleBarForeground" Color="#C8C8C8"/>
                    <SolidColorBrush x:Key="CaptionHover" Color="#15FFFFFF"/>
                    <SolidColorBrush x:Key="CaptionPressed" Color="#20FFFFFF"/>
                    <SolidColorBrush x:Key="CaptionForeground" Color="#E0E0E0"/>

                    <!-- 卡片 -->
                    <SolidColorBrush x:Key="CardBackground" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="CardBorder" Color="#3A3A3A"/>

                    <!-- 文字 -->
                    <SolidColorBrush x:Key="TextPrimary" Color="#E8E8E8"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#A0A0A0"/>
                    <SolidColorBrush x:Key="TextTertiary" Color="#787878"/>
                    <SolidColorBrush x:Key="TextOnAccent" Color="White"/>

                    <!-- 标签 -->
                    <SolidColorBrush x:Key="TagBackground" Color="#1A3A5C"/>
                    <SolidColorBrush x:Key="TagForeground" Color="#6CB8FF"/>
                    <SolidColorBrush x:Key="TagHoverBackground" Color="#244A70"/>

                    <!-- 社交按钮 -->
                    <SolidColorBrush x:Key="SocialBackground" Color="#333333"/>
                    <SolidColorBrush x:Key="SocialBorder" Color="#444444"/>
                    <SolidColorBrush x:Key="SocialHoverBackground" Color="#1A3A5C"/>
                    <SolidColorBrush x:Key="SocialHoverBorder" Color="#4A7AAA"/>
                    <SolidColorBrush x:Key="SocialPressedBackground" Color="#153050"/>
                    <SolidColorBrush x:Key="SocialPressedBorder" Color="#3A6A9A"/>
                    <SolidColorBrush x:Key="SocialIconForeground" Color="#C0C0C0"/>

                    <!-- 技术栈 -->
                    <SolidColorBrush x:Key="TechItemBackground" Color="#333333"/>
                    <SolidColorBrush x:Key="TechItemBorder" Color="#444444"/>
                    <SolidColorBrush x:Key="TechItemHoverBackground" Color="#3A4A5A"/>
                    <SolidColorBrush x:Key="TechItemHoverBorder" Color="#4A7AAA"/>
                    <SolidColorBrush x:Key="TechItemText" Color="#C0C0C0"/>

                    <!-- 分隔线 -->
                    <SolidColorBrush x:Key="Separator" Color="#3A3A3A"/>
                    <SolidColorBrush x:Key="SeparatorLight" Color="#383838"/>

                    <!-- 地图叠加层 -->
                    <SolidColorBrush x:Key="MapOverlayBackground" Color="#252525"/>
                    <SolidColorBrush x:Key="MapOverlayBorder" Color="#3A3A3A"/>

                    <!-- 引用边框 -->
                    <SolidColorBrush x:Key="QuoteBorder" Color="#3A4A5A"/>

                    <!-- 头像边框 -->
                    <SolidColorBrush x:Key="AvatarBorder" Color="#2A2A2A"/>

                    <!-- 封面渐变 -->
                    <LinearGradientBrush x:Key="CoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#003D73" Offset="0"/>
                        <GradientStop Color="#004E8C" Offset="0.3"/>
                        <GradientStop Color="#2A6FA0" Offset="0.7"/>
                        <GradientStop Color="#3D7FAA" Offset="1"/>
                    </LinearGradientBrush>

                    <!-- 地图渐变 -->
                    <LinearGradientBrush x:Key="MapGradientBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A2A3A" Offset="0"/>
                        <GradientStop Color="#152535" Offset="0.5"/>
                        <GradientStop Color="#102030" Offset="1"/>
                    </LinearGradientBrush>

                    <!-- Logo 渐变 -->
                    <LinearGradientBrush x:Key="LogoGradientBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4A90C8" Offset="0"/>
                        <GradientStop Color="#6CB8FF" Offset="1"/>
                    </LinearGradientBrush>

                    <!-- 主题切换按钮 -->
                    <SolidColorBrush x:Key="ThemeToggleForeground" Color="#C0C0C0"/>

                    <!-- 强调色 -->
                    <SolidColorBrush x:Key="AccentBrush" Color="#4A90C8"/>

                    <!-- 位置图标 -->
                    <SolidColorBrush x:Key="LocationIconForeground" Color="#F07070"/>

                    <!-- 头像 fallback 背景 -->
                    <SolidColorBrush x:Key="AvatarFallbackBackground" Color="#2A6FA0"/>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>