<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PersonalCardDemo.MainWindow"
        Width="960" Height="680"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Transparent"
        SystemDecorations="None">

  <!-- ================= 资源 ================= -->
  <Window.Resources>

    <StreamGeometry x:Key="LocationIcon">
      M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z
      M12 11.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z
    </StreamGeometry>

    <StreamGeometry x:Key="XIcon">
      M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z
    </StreamGeometry>

    <StreamGeometry x:Key="GitHubIcon">
      M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z
    </StreamGeometry>

    <StreamGeometry x:Key="CodeIcon">
      M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z
    </StreamGeometry>

    <StreamGeometry x:Key="CppIcon">
      M10.5 15.97l.009.003a7.018 7.018 0 0 1-3.473.898C3.153 16.871 0 13.737 0 9.936S3.153 3 7.036 3a7.018 7.018 0 0 1 3.473.898L10.5 3.903 8.952 5.462l.009.003A4.89 4.89 0 0 0 7.036 5.1c-2.67 0-4.836 2.167-4.836 4.836s2.167 4.836 4.836 4.836a4.89 4.89 0 0 0 1.925-.365l-.009-.003 1.548 1.558zm3.6-3.39h1.2v-1.2h1.2v1.2h1.2v1.2h-1.2v1.2h-1.2v-1.2h-1.2v-1.2zm4.8 0h1.2v-1.2h1.2v1.2h1.2v1.2h-1.2v1.2h-1.2v-1.2h-1.2v-1.2z
    </StreamGeometry>

    <StreamGeometry x:Key="PythonIcon">
      M11.914 0C5.82 0 6.2 2.656 6.2 2.656l.007 2.752h5.814v.826H3.9S0 5.789 0 11.969c0 6.18 3.403 5.96 3.403 5.96h2.03v-2.867s-.109-3.42 3.35-3.42h5.766s3.24.052 3.24-3.148V3.202S18.28 0 11.914 0zM8.708 1.85a1.06 1.06 0 1 1 0 2.12 1.06 1.06 0 0 1 0-2.12z M12.086 24c6.094 0 5.714-2.656 5.714-2.656l-.007-2.752h-5.814v-.826h8.121S24 18.211 24 12.031c0-6.18-3.403-5.96-3.403-5.96h-2.03v2.867s.109 3.42-3.35 3.42H9.451s-3.24-.052-3.24 3.148v5.292S5.72 24 12.086 24zm3.206-1.85a1.06 1.06 0 1 1 0-2.12 1.06 1.06 0 0 1 0 2.12z
    </StreamGeometry>

    <StreamGeometry x:Key="Html5Icon">
      M1.5 0h21l-1.91 21.563L11.977 24l-8.564-2.438L1.5 0zm7.031 9.75l-.232-2.718 10.059.003.071-.747.168-1.969.013-.149H6.16l.558 6.33h7.167l-.276 2.97-2.6.7-2.605-.703-.168-1.874h-2.6l.329 3.63L11.026 17l4.964-1.38.756-8.12H8.531z
    </StreamGeometry>

  </Window.Resources>

  <!-- ================= 样式 ================= -->
  <Window.Styles>

    <!-- macOS 红绿灯按钮 -->
    <Style Selector="Button.traffic">
      <Setter Property="Width" Value="13"/>
      <Setter Property="Height" Value="13"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.traffic TextBlock.icon">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,-1,0,0"/>
    </Style>

    <Style Selector="Button.traffic-close">
      <Setter Property="Background" Value="#FF5F57"/>
    </Style>
    <Style Selector="Button.traffic-minimize">
      <Setter Property="Background" Value="#FEBC2E"/>
    </Style>
    <Style Selector="Button.traffic-maximize">
      <Setter Property="Background" Value="#28C840"/>
    </Style>

    <!-- hover 时显示图标 -->
    <Style Selector="StackPanel.traffic-group:pointerover Button.traffic TextBlock.icon">
      <Setter Property="Foreground" Value="#4D000000"/>
    </Style>

    <Style Selector="Button.traffic-close:pointerover">
      <Setter Property="Background" Value="#FF4136"/>
    </Style>
    <Style Selector="Button.traffic-minimize:pointerover">
      <Setter Property="Background" Value="#F5C451"/>
    </Style>
    <Style Selector="Button.traffic-maximize:pointerover">
      <Setter Property="Background" Value="#2ACB42"/>
    </Style>

    <Style Selector="Button.traffic:pressed">
      <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <!-- 标签 -->
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="#18FFFFFF"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14,6"/>
    </Style>

    <Style Selector="Border.tag TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#EEFFFFFF"/>
    </Style>

    <!-- 社交按钮 -->
    <Style Selector="Button.social">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="CornerRadius" Value="21"/>
      <Setter Property="Background" Value="#15FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform" Value="scale(1,1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
          <BrushTransition Property="Background" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.social:pointerover">
      <Setter Property="Background" Value="#25FFFFFF"/>
      <Setter Property="RenderTransform" Value="scale(1.12,1.12)"/>
    </Style>

    <!-- 技术栈项 -->
    <Style Selector="Border.tech-item">
      <Setter Property="Background" Value="#10FFFFFF"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>

  </Window.Styles>

  <!-- ================= 外层窗口 ================= -->
  <Border CornerRadius="16" ClipToBounds="True">

    <Grid RowDefinitions="40,*">

      <!-- 半透明背景层 -->
      <Border Grid.RowSpan="2" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D1a0533" Offset="0"/>
            <GradientStop Color="#0D4a2c8a" Offset="0.4"/>
            <GradientStop Color="#0Dc75b39" Offset="0.7"/>
            <GradientStop Color="#0D1a3a4a" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <!-- 光晕 -->
      <Ellipse Grid.RowSpan="2"
               Width="500"
               Height="260"
               Opacity="0.15"
               IsHitTestVisible="False"
               VerticalAlignment="Top"
               Margin="0,-80,0,0">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#FFE8A849" Offset="0"/>
            <GradientStop Color="#00E8A849" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- 标题栏 -->
      <Border Grid.Row="0"
              Background="#101A1A2E">
        <Grid>
          <StackPanel Classes="traffic-group"
                      Orientation="Horizontal"
                      Spacing="8"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center">
            <Button Classes="traffic traffic-close" Click="CloseButton_Click">
              <TextBlock Classes="icon" Text="&#xd7;"/>
            </Button>
            <Button Classes="traffic traffic-minimize" Click="MinimizeButton_Click">
              <TextBlock Classes="icon" Text="&#x2013;"/>
            </Button>
            <Button Classes="traffic traffic-maximize" Click="MaximizeButton_Click">
              <TextBlock Classes="icon" Text="+"/>
            </Button>
          </StackPanel>

          <TextBlock Text="个人主页"
                     FontSize="13"
                     Foreground="#AAFFFFFF"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- ================= 主内容 2x2 网格 ================= -->
      <Grid Grid.Row="1"
            Margin="24"
            ColumnDefinitions="300,*"
            RowDefinitions="*,200"
            ColumnSpacing="24"
            RowSpacing="24">

        <!-- ========== 左侧资料卡 (跨两行) ========== -->
        <Border Grid.RowSpan="2" CornerRadius="10" ClipToBounds="True">
          <Panel>
            <ExperimentalAcrylicBorder IsHitTestVisible="False">
              <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="#FFFFFF"
                    TintOpacity="0.02"
                    MaterialOpacity="0.15"/>
              </ExperimentalAcrylicBorder.Material>
            </ExperimentalAcrylicBorder>

            <Border BorderBrush="#30FFFFFF"
                    BorderThickness="1">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#0CFFFFFF" Offset="0"/>
                  <GradientStop Color="#04FFFFFF" Offset="0.3"/>
                  <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect>
                <DropShadowEffect OffsetX="0" OffsetY="8"
                                  BlurRadius="16"
                                  Color="#000000"
                                  Opacity="0.10"/>
              </Border.Effect>

            <Grid RowDefinitions="160,Auto,*">

              <!-- 封面图区域 -->
              <!-- 替换: 将 Assets/cover.jpg 放入项目，取消注释 Image 控件 -->
              <Panel Grid.Row="0">
                <Border>
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#3A1C71" Offset="0"/>
                      <GradientStop Color="#D76D77" Offset="0.5"/>
                      <GradientStop Color="#FFAF7B" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <!-- 放入封面图后取消注释:
                <Image x:Name="CoverImage"
                       Source="avares://PersonalCardDemo/Assets/cover.jpg"
                       Stretch="UniformToFill"/> -->
              </Panel>

              <!-- 头像叠加在封面底部 -->
              <Border Grid.Row="1"
                      Width="90"
                      Height="90"
                      CornerRadius="45"
                      HorizontalAlignment="Center"
                      Margin="0,-45,0,0"
                      BorderThickness="3"
                      ClipToBounds="True">
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#7C3AED" Offset="0"/>
                    <GradientStop Color="#EC4899" Offset="1"/>
                  </LinearGradientBrush>
                </Border.BorderBrush>

                <Panel>
                  <!-- 渐变底色 fallback -->
                  <Border CornerRadius="45">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7C3AED" Offset="0"/>
                        <GradientStop Color="#EC4899" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>

                    <TextBlock Text="K"
                               FontSize="34"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>
                  <!-- 放入头像后取消注释:
                  <Image x:Name="AvatarImage"
                         Source="avares://PersonalCardDemo/Assets/avatar.png"
                         Stretch="UniformToFill"/> -->
                </Panel>
              </Border>

              <!-- 信息区 -->
              <StackPanel Grid.Row="2" Spacing="16" Margin="24,8,24,24">

                <!-- 名字 -->
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                  <TextBlock Text="Kilock"
                             FontSize="22"
                             FontWeight="SemiBold"
                             Foreground="White"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="@kilock_1208"
                             FontSize="13"
                             Foreground="#BBFFFFFF"
                             HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 标签 -->
                <WrapPanel HorizontalAlignment="Center"
                           ItemSpacing="8">
                  <Border Classes="tag">
                    <TextBlock Text="Dev"/>
                  </Border>
                  <Border Classes="tag">
                    <TextBlock Text="INTP"/>
                  </Border>
                  <Border Classes="tag">
                    <TextBlock Text="Mtx"/>
                  </Border>
                </WrapPanel>

                <!-- 签名 -->
                <TextBlock Text="&#x201C;清凤凤凤凤凤!&#x201D;"
                           FontStyle="Italic"
                           FontSize="13"
                           Foreground="#DDFFFFFF"
                           TextAlignment="Center"/>

                <!-- 社交按钮 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="16"
                            Margin="0,4,0,0">
                  <Button Classes="social">
                    <PathIcon Data="{StaticResource XIcon}"
                              Foreground="White"
                              Width="18" Height="18"/>
                  </Button>
                  <Button Classes="social">
                    <PathIcon Data="{StaticResource GitHubIcon}"
                              Foreground="White"
                              Width="18" Height="18"/>
                  </Button>
                </StackPanel>

              </StackPanel>
            </Grid>
          </Border>
          </Panel>
        </Border>

        <!-- ========== 右上: 地图卡 ========== -->
        <Border Grid.Column="1" Grid.Row="0" CornerRadius="10" ClipToBounds="True">
          <Panel>
            <ExperimentalAcrylicBorder IsHitTestVisible="False">
              <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="#FFFFFF"
                    TintOpacity="0.02"
                    MaterialOpacity="0.15"/>
              </ExperimentalAcrylicBorder.Material>
            </ExperimentalAcrylicBorder>

            <Border BorderBrush="#30FFFFFF"
                    BorderThickness="1">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#0CFFFFFF" Offset="0"/>
                  <GradientStop Color="#04FFFFFF" Offset="0.3"/>
                  <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect>
                <DropShadowEffect OffsetX="0" OffsetY="8"
                                  BlurRadius="16"
                                  Color="#000000"
                                  Opacity="0.10"/>
              </Border.Effect>

            <Grid>
              <!-- 地图图片占位 -->
              <!-- 替换: 将 Assets/map.png 放入项目，取消注释 Image 控件 -->
              <Border>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F2027" Offset="0"/>
                    <GradientStop Color="#203A43" Offset="0.5"/>
                    <GradientStop Color="#2C5364" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <!-- 放入地图截图后取消注释:
              <Image x:Name="MapImage"
                     Source="avares://PersonalCardDemo/Assets/map.png"
                     Stretch="UniformToFill"/> -->

              <!-- 底部地点信息叠加 -->
              <Border VerticalAlignment="Bottom"
                      Padding="24,16">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#AA000000" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>

                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource LocationIcon}"
                              Foreground="#EF4444"
                              Width="18" Height="18"/>
                    <TextBlock Text="浙江 · 宁波"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                  </StackPanel>
                  <TextBlock Text="qwqwqwq!"
                             FontSize="13"
                             Foreground="#DDFFFFFF"
                             Margin="26,0,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          </Panel>
        </Border>

        <!-- ========== 右下: 两张小卡片 ========== -->
        <Grid Grid.Column="1" Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="16">

          <!-- 右下左: 技术栈卡 -->
          <Border Grid.Column="0" CornerRadius="10" ClipToBounds="True">
            <Panel>
              <ExperimentalAcrylicBorder IsHitTestVisible="False">
                <ExperimentalAcrylicBorder.Material>
                  <ExperimentalAcrylicMaterial
                      BackgroundSource="Digger"
                      TintColor="#FFFFFF"
                      TintOpacity="0.02"
                      MaterialOpacity="0.15"/>
                </ExperimentalAcrylicBorder.Material>
              </ExperimentalAcrylicBorder>

              <Border BorderBrush="#30FFFFFF"
                      BorderThickness="1">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#0CFFFFFF" Offset="0"/>
                    <GradientStop Color="#04FFFFFF" Offset="0.3"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                  <DropShadowEffect OffsetX="0" OffsetY="8"
                                    BlurRadius="16"
                                    Color="#000000"
                                    Opacity="0.10"/>
                </Border.Effect>

              <StackPanel Margin="16,14" Spacing="10">
                <!-- 标题 -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource CodeIcon}"
                            Foreground="#60A5FA"
                            Width="14" Height="14"/>
                  <TextBlock Text="Tech Stack"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="White"/>
                </StackPanel>

                <!-- 技术栈列表 -->
                <WrapPanel ItemSpacing="6">
                  <Border Classes="tech-item">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <PathIcon Data="{StaticResource CppIcon}"
                                Foreground="#00599C"
                                Width="12" Height="12"/>
                      <TextBlock Text="C++"
                                 FontSize="11"
                                 Foreground="#EEFFFFFF"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <Border Classes="tech-item">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <PathIcon Data="{StaticResource PythonIcon}"
                                Foreground="#3776AB"
                                Width="12" Height="12"/>
                      <TextBlock Text="Python"
                                 FontSize="11"
                                 Foreground="#EEFFFFFF"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <Border Classes="tech-item">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <PathIcon Data="{StaticResource Html5Icon}"
                                Foreground="#E34F26"
                                Width="12" Height="12"/>
                      <TextBlock Text="HTML5"
                                 FontSize="11"
                                 Foreground="#EEFFFFFF"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </WrapPanel>

                <!-- GitHub 链接 -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource GitHubIcon}"
                            Foreground="#BBFFFFFF"
                            Width="12" Height="12"/>
                  <TextBlock Text="github.com/kilockok"
                             FontSize="11"
                             Foreground="#BBFFFFFF"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>
            </Panel>
          </Border>

          <!-- 右下右: 预留卡片 -->
          <Border Grid.Column="1" CornerRadius="10" ClipToBounds="True">
            <Panel>
              <ExperimentalAcrylicBorder IsHitTestVisible="False">
                <ExperimentalAcrylicBorder.Material>
                  <ExperimentalAcrylicMaterial
                      BackgroundSource="Digger"
                      TintColor="#FFFFFF"
                      TintOpacity="0.02"
                      MaterialOpacity="0.15"/>
                </ExperimentalAcrylicBorder.Material>
              </ExperimentalAcrylicBorder>

              <Border BorderBrush="#30FFFFFF"
                      BorderThickness="1">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#0CFFFFFF" Offset="0"/>
                    <GradientStop Color="#04FFFFFF" Offset="0.3"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                  <DropShadowEffect OffsetX="0" OffsetY="8"
                                    BlurRadius="16"
                                    Color="#000000"
                                    Opacity="0.10"/>
                </Border.Effect>

                <TextBlock Text="Coming Soon"
                           FontSize="14"
                           Foreground="#55FFFFFF"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>
            </Panel>
          </Border>

        </Grid>

      </Grid>

    </Grid>

  </Border>

</Window>
