    <StreamGeometry x:Key="XIcon">
      M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z
    </StreamGeometry>

    <StreamGeometry x:Key="GitHubIcon">
      M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z
    </StreamGeometry>

    <StreamGeometry x:Key="CodeIcon">
      M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z
    </StreamGeometry>

    <StreamGeometry x:Key="CppIcon">
      M10.5 15.97l.009.003a7.018 7.018 0 0 1-3.473.898C3.153 16.871 0 13.737 0 9.936S3.153 3 7.036 3a7.018 7.018 0 0 1 3.473.898L10.5 3.903 8.952 5.462l.009.003A4.89 4.89 0 0 0 7.036 5.1c-2.67 0-4.836 2.167-4.836 4.836s2.167 4.836 4.836 4.836a4.89 4.89 0 0 0 1.925-.365l-.009-.003 1.548 1.558zm3.6-3.39h1.2v-1.2h1.2v1.2h1.2v1.2h-1.2v1.2h-1.2v-1.2h-1.2v-1.2zm4.8 0h1.2v-1.2h1.2v1.2h1.2v1.2h-1.2v1.2h-1.2v-1.2h-1.2v-1.2z
    </StreamGeometry>

    <StreamGeometry x:Key="PythonIcon">
      M11.914 0C5.82 0 6.2 2.656 6.2 2.656l.007 2.752h5.814v.826H3.9S0 5.789 0 11.969c0 6.18 3.403 5.96 3.403 5.96h2.03v-2.867s-.109-3.42 3.35-3.42h5.766s3.24.052 3.24-3.148V3.202S18.28 0 11.914 0zM8.708 1.85a1.06 1.06 0 1 1 0 2.12 1.06 1.06 0 0 1 0-2.12z M12.086 24c6.094 0 5.714-2.656 5.714-2.656l-.007-2.752h-5.814v-.826h8.121S24 18.211 24 12.031c0-6.18-3.403-5.96-3.403-5.96h-2.03v2.867s.109 3.42-3.35 3.42H9.451s-3.24-.052-3.24 3.148v5.292S5.72 24 12.086 24zm3.206-1.85a1.06 1.06 0 1 1 0-2.12 1.06 1.06 0 0 1 0 2.12z
    </StreamGeometry>

    <StreamGeometry x:Key="Html5Icon">
      M1.5 0h21l-1.91 21.563L11.977 24l-8.564-2.438L1.5 0zm7.031 9.75l-.232-2.718 10.059.003.071-.747.168-1.969.013-.149H6.16l.558 6.33h7.167l-.276 2.97-2.6.7-2.605-.703-.168-1.874h-2.6l.329 3.63L11.026 17l4.964-1.38.756-8.12H8.531z
    </StreamGeometry>

    <StreamGeometry x:Key="VueIcon">
      M24 1.61h-9.94L12 5.16 9.94 1.61H0l12 20.78L24 1.61zM12 14.08L5.16 2.23h4.43L12 6.41l2.41-4.18h4.43L12 14.08z
    </StreamGeometry>

    <StreamGeometry x:Key="NodeJsIcon">
      M11.998 24c-.321 0-.641-.084-.922-.247l-2.936-1.737c-.438-.245-.224-.332-.08-.383.585-.203.703-.25 1.328-.604.065-.037.151-.023.218.017l2.256 1.339a.29.29 0 0 0 .272 0l8.795-5.076a.277.277 0 0 0 .134-.238V6.921a.28.28 0 0 0-.137-.242L12.137 1.6a.27.27 0 0 0-.27 0L3.077 6.68a.282.282 0 0 0-.14.243v10.15a.27.27 0 0 0 .138.235l2.409 1.392c1.307.654 2.108-.116 2.108-.89V7.787c0-.142.114-.253.256-.253h1.115c.139 0 .255.112.255.253v10.021c0 1.745-.95 2.745-2.604 2.745-.508 0-.909 0-2.026-.551L2.28 18.675A1.857 1.857 0 0 1 1.36 17.07V6.921c0-.645.344-1.248.92-1.569L11.075.276a1.932 1.932 0 0 1 1.846 0l8.794 5.076c.577.322.92.924.92 1.569v10.15a1.86 1.86 0 0 1-.92 1.57l-8.794 5.076a1.855 1.855 0 0 1-.923.283z
    </StreamGeometry>

    <StreamGeometry x:Key="BlogIcon">
      M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z
    </StreamGeometry>

    <StreamGeometry x:Key="DockerIcon">
      M13.983 11.078h2.119a.186.186 0 0 0 .186-.185V9.006a.186.186 0 0 0-.186-.186h-2.119a.186.186 0 0 0-.187.186v1.887c0 .103.084.185.187.185zm-2.954-5.43h2.118a.186.186 0 0 0 .187-.185V3.576a.186.186 0 0 0-.187-.186h-2.118a.186.186 0 0 0-.187.186v1.887c0 .102.084.185.187.185zm0 2.716h2.118a.186.186 0 0 0 .187-.186V6.291a.186.186 0 0 0-.187-.186h-2.118a.186.186 0 0 0-.187.186v1.887c0 .103.084.186.187.186zm-2.93 0h2.12a.186.186 0 0 0 .186-.186V6.291a.186.186 0 0 0-.187-.186H8.1a.186.186 0 0 0-.188.186v1.887c0 .103.085.186.188.186zm-2.93 0h2.12a.186.186 0 0 0 .186-.186V6.291a.186.186 0 0 0-.186-.186h-2.12a.186.186 0 0 0-.187.186v1.887c0 .103.084.186.187.186zm5.86 2.714h2.118a.186.186 0 0 0 .187-.185V9.006a.186.186 0 0 0-.187-.186h-2.118a.186.186 0 0 0-.187.186v1.887c0 .103.084.185.187.185zm-2.93 0h2.12a.186.186 0 0 0 .186-.185V9.006a.186.186 0 0 0-.187-.186H8.1a.186.186 0 0 0-.188.186v1.887c0 .103.085.185.188.185zm-2.93 0h2.12a.186.186 0 0 0 .186-.185V9.006a.186.186 0 0 0-.186-.186h-2.12a.186.186 0 0 0-.187.186v1.887c0 .103.084.185.187.185zm-2.931 0h2.12a.186.186 0 0 0 .187-.185V9.006a.186.186 0 0 0-.186-.186h-2.12a.186.186 0 0 0-.187.186v1.887c0 .103.084.185.186.185zM24 11.5c-.001-.246-.154-.586-.343-.682-.472-.24-3.177-.508-3.177-.508s-1.86-1.92-2.073-2.14a.533.533 0 0 0-.378-.127c-.076 0-.152.013-.228.038-.34.113-.59.474-.766.87-.273.614-.508 1.674-.508 1.674s-1.063-.107-2.395-.107c-1.626 0-1.685.466-1.685.572 0 .603 1.106 3.728 3.518 5.45 2.218 1.586 4.503 1.46 4.503 1.46h1.06c.957-.11 1.477-.6 1.477-.6.58-.525.99-1.18.99-1.18s.164-.222.164-.586c0-.364-.16-.748-.16-.748z
    </StreamGeometry>

  </Window.Resources>

  <!-- ================= 样式 ================= -->
  <Window.Styles>

    <!-- 全局 TextBlock 主题切换过渡 -->
    <Style Selector="TextBlock">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.25"/>
        </Transitions>
      </Setter>
    </Style>

    <!-- 全局 PathIcon 主题切换过渡 -->
    <Style Selector="PathIcon">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.25"/>
        </Transitions>
      </Setter>
    </Style>

    <!-- Windows 标题栏按钮 -->
    <Style Selector="Button.win-caption">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.1"/>
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.win-caption:pointerover">
      <Setter Property="Background" Value="{DynamicResource CaptionHover}"/>
    </Style>

    <Style Selector="Button.win-caption:pressed">
      <Setter Property="Background" Value="{DynamicResource CaptionPressed}"/>
    </Style>

    <Style Selector="Button.win-caption-close:pointerover">
      <Setter Property="Background" Value="#E81123"/>
    </Style>

    <Style Selector="Button.win-caption-close:pointerover TextBlock">
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.win-caption-close:pressed">
      <Setter Property="Background" Value="#F1707A"/>
    </Style>

    <Style Selector="Button.win-caption TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource CaptionForeground}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 标签 -->
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="{DynamicResource TagBackground}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform" Value="scale(1,1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.tag:pointerover">
      <Setter Property="Background" Value="{DynamicResource TagHoverBackground}"/>
      <Setter Property="RenderTransform" Value="scale(1.05,1.05)"/>
    </Style>

    <Style Selector="Border.tag TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TagForeground}"/>
    </Style>

    <!-- 社交按钮 -->
    <Style Selector="Button.social">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Background" Value="{DynamicResource SocialBackground}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SocialBorder}"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform" Value="scale(1,1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.social:pointerover">
      <Setter Property="Background" Value="{DynamicResource SocialHoverBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SocialHoverBorder}"/>
      <Setter Property="RenderTransform" Value="scale(1.08,1.08)"/>
    </Style>

    <Style Selector="Button.social:pressed">
      <Setter Property="Background" Value="{DynamicResource SocialPressedBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SocialPressedBorder}"/>
      <Setter Property="RenderTransform" Value="scale(0.96,0.96)"/>
    </Style>

    <!-- 技术栈项 -->
    <Style Selector="Border.tech-item">
      <Setter Property="Background" Value="{DynamicResource TechItemBackground}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TechItemBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform" Value="scale(1,1) translateY(0)"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.tech-item:pointerover">
      <Setter Property="Background" Value="{DynamicResource TechItemHoverBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TechItemHoverBorder}"/>
      <Setter Property="RenderTransform" Value="scale(1.04,1.04) translateY(-1px)"/>
    </Style>

    <!-- Fluent 卡片 -->
    <Style Selector="Border.fluent-card">
      <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.25"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>

  </Window.Styles>

  <!-- ================= 外层窗口 ================= -->
  <Border CornerRadius="8" ClipToBounds="True"
          Background="{DynamicResource WindowBackground}"
          BorderBrush="{DynamicResource WindowBorder}"
          BorderThickness="1">
    <Border.Transitions>
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.25"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
      </Transitions>
    </Border.Transitions>

    <Grid RowDefinitions="32,*">

      <!-- 标题栏 (Windows 11 风格) -->
      <Border Grid.Row="0"
              Background="{DynamicResource TitleBarBackground}"
              BorderBrush="{DynamicResource TitleBarBorder}"
              BorderThickness="0,0,0,1">
        <Border.Transitions>
          <Transitions>
            <BrushTransition Property="Background" Duration="0:0:0.25"/>
            <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
          </Transitions>
        </Border.Transitions>
        <Grid>
          <!-- 左侧标题 -->
          <StackPanel Orientation="Horizontal"
                      Spacing="10"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left">
            <Border Width="18" Height="18" CornerRadius="4"
                    Background="{DynamicResource LogoGradientBrush}">
              <TextBlock Text="C"
                         FontSize="10"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextOnAccent}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="CardSpace"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleBarForeground}"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <!-- 右侧窗口控制按钮 -->
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top">
            <Button Classes="win-caption" Click="ThemeToggle_Click"
                    x:Name="ThemeToggleButton"
                    ToolTip.Tip="切换主题">
              <PathIcon x:Name="ThemeToggleIcon"
                        Data="{StaticResource MoonIcon}"
                        Foreground="{DynamicResource ThemeToggleForeground}"
                        Width="14" Height="14"/>
            </Button>
            <Button Classes="win-caption" Click="MinimizeButton_Click">
              <TextBlock Text="&#x2014;"/>
            </Button>
            <Button Classes="win-caption" Click="MaximizeButton_Click">
              <TextBlock Text="&#x25A1;"/>
            </Button>
            <Button Classes="win-caption win-caption-close" Click="CloseButton_Click">
              <TextBlock Text="&#x2715;"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ================= 主内容 2x2 网格 ================= -->
      <Grid Grid.Row="1"
            Margin="20,8,20,20"
            ColumnDefinitions="300,*"
            RowDefinitions="*,210"
            ColumnSpacing="16"
            RowSpacing="16">

        <!-- ========== 左侧资料卡 (跨两行) ========== -->
        <Border x:Name="ProfileCard" Grid.RowSpan="2" Classes="fluent-card" Opacity="0">
          <Border.Effect>
            <DropShadowEffect OffsetX="0" OffsetY="2"
                              BlurRadius="8"
                              Color="#000000"
                              Opacity="0.06"/>
          </Border.Effect>

          <Grid RowDefinitions="170,Auto,*">

            <!-- 封面图区域 -->
            <Panel Grid.Row="0">
              <Border Background="{DynamicResource CoverGradientBrush}"/>
              <Image x:Name="CoverImage"
                     Source="avares://PersonalCardDemo/Assets/cover.jpg"
                     Stretch="UniformToFill"/>
            </Panel>

            <!-- 头像叠加在封面底部 -->
            <Border Grid.Row="1"
                    Width="96"
                    Height="96"
                    CornerRadius="48"
                    HorizontalAlignment="Center"
                    Margin="0,-48,0,0"
                    BorderThickness="4"
                    BorderBrush="{DynamicResource AvatarBorder}"
                    ClipToBounds="True">
              <Border.Effect>
                <DropShadowEffect OffsetX="0" OffsetY="2"
                                  BlurRadius="8"
                                  Color="#000000"
                                  Opacity="0.12"/>
              </Border.Effect>

              <Panel>
                <!-- 渐变底色 fallback -->
                <Border CornerRadius="44"
                        Background="{DynamicResource AvatarFallbackBackground}">
                  <TextBlock Text="K"
                             FontSize="36"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextOnAccent}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <Border CornerRadius="44" ClipToBounds="True">
                  <Image x:Name="AvatarImage"
                         Source="avares://PersonalCardDemo/Assets/avatar.png"
                         Stretch="UniformToFill"/>
                </Border>
              </Panel>
            </Border>

            <!-- 信息区 -->
            <StackPanel Grid.Row="2" Spacing="14" Margin="24,6,24,24">

              <!-- 名字 -->
              <StackPanel Spacing="2" HorizontalAlignment="Center">
                <TextBlock Text="Kilock"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="@kilock_1208"
                           FontSize="13"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center"/>
              </StackPanel>

              <!-- 标签 -->
              <WrapPanel HorizontalAlignment="Center"
                         ItemSpacing="8">
                <Border Classes="tag">
                  <TextBlock Text="Dev"/>
                </Border>
                <Border Classes="tag">
                  <TextBlock Text="INTP"/>
                </Border>
                <Border Classes="tag">
                  <TextBlock Text="Mtx"/>
                </Border>
              </WrapPanel>

              <!-- 分隔线 -->
              <Border Height="1" Background="{DynamicResource Separator}" Margin="8,2">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25"/>
                  </Transitions>
                </Border.Transitions>
              </Border>

              <!-- 签名 -->
              <TextBlock Text="&#x201C;清凤凤凤凤凤!&#x201D;"
                         FontStyle="Italic"
                         FontSize="13"
                         Foreground="{DynamicResource TextSecondary}"
                         TextAlignment="Center"/>

              <!-- 社交按钮 -->
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          Spacing="12"
                          Margin="0,2,0,0">
                <Button Classes="social" Click="XButton_Click">
                  <PathIcon Data="{StaticResource XIcon}"
                            Foreground="{DynamicResource SocialIconForeground}"
                            Width="16" Height="16"/>
                </Button>
                <Button Classes="social" Click="GitHubButton_Click">
                  <PathIcon Data="{StaticResource GitHubIcon}"
                            Foreground="{DynamicResource SocialIconForeground}"
                            Width="16" Height="16"/>
                </Button>
              </StackPanel>

            </StackPanel>
          </Grid>
        </Border>

        <!-- ========== 右上: 地图卡 ========== -->
        <Border x:Name="MapCard" Grid.Column="1" Grid.Row="0" Classes="fluent-card" Opacity="0">
          <Border.Effect>
            <DropShadowEffect OffsetX="0" OffsetY="2"
                              BlurRadius="8"
                              Color="#000000"
                              Opacity="0.06"/>
          </Border.Effect>

          <Grid>
            <!-- 地图图片占位 -->
            <Border Background="{DynamicResource MapGradientBrush}"/>
            <Image x:Name="MapImage"
                   Source="avares://PersonalCardDemo/Assets/map.png"
                   Stretch="UniformToFill"/>

            <!-- 底部地点信息叠加 -->
            <Border VerticalAlignment="Bottom"
                    Padding="20,14"
                    Background="{DynamicResource MapOverlayBackground}"
                    BorderBrush="{DynamicResource MapOverlayBorder}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.25"/>
                  <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
                </Transitions>
              </Border.Transitions>

              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource LocationIcon}"
                            Foreground="{DynamicResource LocationIconForeground}"
                            Width="18" Height="18"/>
                  <TextBlock Text="浙江 · 宁波"
                             FontSize="16"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
                <TextBlock Text="qwqwqwq!"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="26,0,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- ========== 右下: 两张小卡片 ========== -->
        <Grid Grid.Column="1" Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="16">

          <!-- 右下左: 技术栈卡 -->
          <Border x:Name="TechCard" Grid.Column="0" Classes="fluent-card" Opacity="0">
            <Border.Effect>
              <DropShadowEffect OffsetX="0" OffsetY="2"
                                BlurRadius="8"
                                Color="#000000"
                                Opacity="0.06"/>
            </Border.Effect>

            <StackPanel Margin="16,12" Spacing="8">
              <!-- 标题 -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource CodeIcon}"
                          Foreground="{DynamicResource AccentBrush}"
                          Width="14" Height="14"/>
                <TextBlock Text="Tech Stack"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
              </StackPanel>

              <!-- 技术栈列表 -->
              <WrapPanel ItemSpacing="8">
                <Border Classes="tech-item">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon Data="{StaticResource CppIcon}"
                              Foreground="#00599C"
                              Width="12" Height="12"/>
                    <TextBlock Text="C++"
                               FontSize="11"
                               Foreground="{DynamicResource TechItemText}"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border Classes="tech-item">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon Data="{StaticResource PythonIcon}"
                              Foreground="#3776AB"
                              Width="12" Height="12"/>
                    <TextBlock Text="Python"
                               FontSize="11"
                               Foreground="{DynamicResource TechItemText}"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border Classes="tech-item">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon Data="{StaticResource Html5Icon}"
                              Foreground="#E34F26"
                              Width="12" Height="12"/>
                    <TextBlock Text="HTML5"
                               FontSize="11"
                               Foreground="{DynamicResource TechItemText}"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border Classes="tech-item">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon Data="{StaticResource VueIcon}"
                              Foreground="#42B883"
                              Width="12" Height="12"/>
                    <TextBlock Text="Vue"
                               FontSize="11"
                               Foreground="{DynamicResource TechItemText}"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border Classes="tech-item">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon Data="{StaticResource NodeJsIcon}"
                              Foreground="#339933"
                              Width="12" Height="12"/>
                    <TextBlock Text="Node.js"
                               FontSize="11"
                               Foreground="{DynamicResource TechItemText}"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border Classes="tech-item">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon Data="{StaticResource DockerIcon}"
                              Foreground="#2496ED"
                              Width="12" Height="12"/>
                    <TextBlock Text="Docker"
                               FontSize="11"
                               Foreground="{DynamicResource TechItemText}"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </WrapPanel>

              <!-- 链接区域 -->
              <Border Height="1" Background="{DynamicResource SeparatorLight}" Margin="0,2,0,0">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25"/>
                  </Transitions>
                </Border.Transitions>
              </Border>

              <!-- GitHub 链接 -->
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource GitHubIcon}"
                          Foreground="{DynamicResource TextTertiary}"
                          Width="12" Height="12"/>
                <TextBlock Text="github.com/kilockok"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiary}"
                           VerticalAlignment="Center"/>
              </StackPanel>

              <!-- 博客链接 -->
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource BlogIcon}"
                          Foreground="{DynamicResource TextTertiary}"
                          Width="12" Height="12"/>
                <TextBlock Text="清凤.fun"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiary}"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 右下右: 理念卡片 -->
          <Border x:Name="PhilosophyCard" Grid.Column="1" Classes="fluent-card" Opacity="0">
            <Border.Effect>
              <DropShadowEffect OffsetX="0" OffsetY="2"
                                BlurRadius="8"
                                Color="#000000"
                                Opacity="0.06"/>
            </Border.Effect>

            <StackPanel Margin="20,18" Spacing="10"
                        VerticalAlignment="Center">
              <!-- 装饰色条 -->
              <Border Width="32" Height="4"
                      CornerRadius="2"
                      Background="{DynamicResource AccentBrush}"
                      HorizontalAlignment="Left"/>

              <TextBlock Text="Our Philosophy"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimary}"
                         Margin="0,2,0,0"/>

              <!-- 引用区域 -->
              <Border BorderThickness="3,0,0,0"
                      BorderBrush="{DynamicResource QuoteBorder}"
                      Padding="12,4,0,4">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
                  </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="6">
                  <TextBlock Text="活下去，去做更多、更优秀的作品"
                             FontSize="12.5"
                             Foreground="{DynamicResource TextSecondary}"
                             TextWrapping="Wrap"
                             LineHeight="20"/>
                  <TextBlock Text="以及陪着清凤"
                             FontSize="12"
                             Foreground="{DynamicResource TextTertiary}"
                             FontStyle="Italic"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

        </Grid>

      </Grid>

    </Grid>

  </Border>

</Window>
